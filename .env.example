# ==============================================================================
# HoldBuddy Environment Configuration Template
# NOTE: This file contains NO SECRETS. Copy to .env for local development only.
# ==============================================================================

# Server Network Configuration
PORT=10000
HOST=127.0.0.1
PUBLIC_ORIGIN=http://127.0.0.1:10000

# Telephony Execution Mode:
# - "offline_mock" (default): Runs the offline deterministic simulator (0 API credits used).
# - "live_native": Local Asterisk ARI and live Gnani Prisma STT (requires local Asterisk PBX).
TELEPHONY_MODE=offline_mock

# Gnani AI API Credentials (OPTIONAL — ONLY required for genuine live native testing)
# Leave blank for local offline simulation. Never commit actual API keys to git.
GNANI_API_KEY=

# Local Asterisk PBX Path Configuration (OPTIONAL — ONLY required for native qualification)
# AST_RUNTIME_PATH=./runtime/asterisk
# ASTERISK_BINARY_PATH=/usr/sbin/asterisk
