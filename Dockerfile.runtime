FROM node:22-bookworm-slim@sha256:5ec23b7c622b00547753bc6ffd78085dd868a68aeb41c8e0a1418f033e13d96d AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY tsconfig.json scenarios.json ./
COPY apps ./apps
COPY packages ./packages
COPY server ./server
COPY scripts/build.mjs ./scripts/build.mjs
COPY scripts/collect-notices.mjs ./scripts/collect-notices.mjs
COPY assets ./assets
COPY THIRD_PARTY_NOTICES.md ./
COPY licenses ./licenses
RUN npm run typecheck && npm run build && node scripts/collect-notices.mjs

FROM node:22-bookworm-slim@sha256:5ec23b7c622b00547753bc6ffd78085dd868a68aeb41c8e0a1418f033e13d96d AS runtime
ENV NODE_ENV=production PORT=10000
WORKDIR /app
COPY --from=build --chown=node:node /app/dist ./dist
USER node
EXPOSE 10000
CMD ["node", "--permission", "--allow-fs-read=/app/dist", "--allow-fs-read=/tmp", "--allow-fs-write=/tmp", "--max-old-space-size=256", "dist/server.mjs"]

